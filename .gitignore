# Unity .gitignore for Maze Runner
# Keeps the repository clean and ready for GitHub clone & play

# Unity generated caches and temporary files
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Aa]ssets/AssetStoreTools*

# Autogenerated Visual Studio / VS Code solution & project files
.vs/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Unity Crash Handler
sysinfo.txt
crashpad_handler.exe

# OS generated
.DS_Store
Thumbs.db
desktop.ini

# Android native build intermediates
.utmp/
[Aa]rchived*.zip
*.zip

# Video Editing & Marketing Folder (keeps repository 100% pure game code)
Assets/Video Editing/
*.mp4
*.mov

# Android Builds (distribute via GitHub Releases)
*.apk
*.aab
*.symbols.zip
Builds/
build/
builds/


